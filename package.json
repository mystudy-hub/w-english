{
  "name": "w-english",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first children's English vocabulary and phonics learning.",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "node scripts/build-content.mjs --preview",
    "validate:content": "node scripts/validate-words.mjs --catalog",
    "validate:assets": "node scripts/validate-assets.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-playwright.mjs test",
    "browsers:install": "node scripts/run-playwright.mjs install chromium",
    "build:preview": "node scripts/build-content.mjs --preview && tsc -b && vite build --mode preview",
    "build:release": "node scripts/build-content.mjs --release && tsc -b && vite build --mode production",
    "build": "npm run build:preview",
    "preview": "vite preview --host 127.0.0.1",
    "audio:inventory": "node scripts/audio-inventory.mjs",
    "audio:generate": "python scripts/generate_audio.py",
    "audio:pack": "node scripts/pack-audio.mjs",
    "content:review": "node scripts/review-inventory.mjs",
    "review:import": "node scripts/import-review.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "dexie": "4.4.5",
    "framer-motion": "12.43.0",
    "howler": "2.2.4",
    "lucide-react": "1.43.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/howler": "2.2.13",
    "@types/node": "24.13.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-range-requests": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
