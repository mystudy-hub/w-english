{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "src/sw.ts", "tests/**/*.ts", "tests/**/*.tsx"]
}
